# Copy to .env.staging outside version control and replace every placeholder.
# Keep APP_BIND at 127.0.0.1 behind a private local reverse proxy.
POSTGRES_USER=afroie_staging
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=afroie_staging
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
APP_ENV=staging
DEMO_DATA_ENABLED=false
INVITE_ONLY=true
APP_ORIGIN=https://staging.example.ie
RUN_MIGRATIONS=false
LOAD_DEMO_DATA=false
APP_BIND=127.0.0.1
APP_PORT=3000
